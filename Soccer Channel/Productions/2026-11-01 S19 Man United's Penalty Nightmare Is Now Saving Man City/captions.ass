Dialogue: 0,0:00:00.00,0:00:03.10,Cap,,0,0,0,,{\pos(540,960)\blur0.5\fscx58\fscy58}Manchester United's penalty NIGHTMARE\Nis now saving MANCHESTER CITY
Dialogue: 0,0:00:03.10,0:00:04.54,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Back in 2021,
Dialogue: 0,0:00:04.54,0:00:05.33,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Gerónimo Rulli
Dialogue: 0,0:00:05.33,0:00:05.83,Cap,,0,0,0,,{\pos(540,960)\blur0.5}was in goal
Dialogue: 0,0:00:05.83,0:00:06.69,Cap,,0,0,0,,{\pos(540,960)\blur0.5}for Villarreal
Dialogue: 0,0:00:06.69,0:00:07.26,Cap,,0,0,0,,{\pos(540,960)\blur0.5}in the Europa
Dialogue: 0,0:00:07.26,0:00:07.85,Cap,,0,0,0,,{\pos(540,960)\blur0.5}League final,
Dialogue: 0,0:00:07.85,0:00:08.19,Cap,,0,0,0,,{\pos(540,960)\blur0.5}against
Dialogue: 0,0:00:08.19,0:00:08.99,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Manchester United.
Dialogue: 0,0:00:08.99,0:00:10.00,Cap,,0,0,0,,{\pos(540,960)\blur0.5}1-1 after extra
Dialogue: 0,0:00:10.00,0:00:10.52,Cap,,0,0,0,,{\pos(540,960)\blur0.5}time, so,
