Dialogue: 0,0:00:00.00,0:00:02.17,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Barcelona signed Messi\Non a paper NAPKIN
Dialogue: 0,0:00:02.17,0:00:03.25,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Back in 2000,
Dialogue: 0,0:00:03.25,0:00:04.00,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Lionel Messi
