Dialogue: 0,0:00:00.00,0:00:02.42,Cap,,0,0,0,,{\pos(540,960)\blur0.5\fscx80\fscy80}Goalkeepers who hid a\NCHEAT SHEET on their water bottle
Dialogue: 0,0:00:02.42,0:00:03.46,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Back in 2018,
Dialogue: 0,0:00:03.46,0:00:03.96,Cap,,0,0,0,,{\pos(540,960)\blur0.5}England played
Dialogue: 0,0:00:03.96,0:00:04.64,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Colombia at the
Dialogue: 0,0:00:04.64,0:00:05.18,Cap,,0,0,0,,{\pos(540,960)\blur0.5}World Cup,
Dialogue: 0,0:00:05.18,0:00:05.67,Cap,,0,0,0,,{\pos(540,960)\blur0.5}and England
Dialogue: 0,0:00:05.67,0:00:06.34,Cap,,0,0,0,,{\pos(540,960)\blur0.5}had never won
Dialogue: 0,0:00:06.34,0:00:06.82,Cap,,0,0,0,,{\pos(540,960)\blur0.5}a World Cup
Dialogue: 0,0:00:06.82,0:00:07.65,Cap,,0,0,0,,{\pos(540,960)\blur0.5}penalty shootout.
Dialogue: 0,0:00:07.65,0:00:08.02,Cap,,0,0,0,,{\pos(540,960)\blur0.5}They lost
Dialogue: 0,0:00:08.02,0:00:08.88,Cap,,0,0,0,,{\pos(540,960)\blur0.5}in 1990,
Dialogue: 0,0:00:08.88,0:00:09.77,Cap,,0,0,0,,{\pos(540,960)\blur0.5}in 1998,
Dialogue: 0,0:00:09.77,0:00:10.94,Cap,,0,0,0,,{\pos(540,960)\blur0.5}and in 2006.
Dialogue: 0,0:00:10.94,0:00:11.54,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Then, deep
Dialogue: 0,0:00:11.54,0:00:12.59,Cap,,0,0,0,,{\pos(540,960)\blur0.5}into stoppage time,
Dialogue: 0,0:00:12.59,0:00:13.49,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Yerry Mina headed
Dialogue: 0,0:00:13.49,0:00:14.20,Cap,,0,0,0,,{\pos(540,960)\blur0.5}in an equalizer
Dialogue: 0,0:00:14.20,0:00:14.90,Cap,,0,0,0,,{\pos(540,960)\blur0.5}for Colombia.
Dialogue: 0,0:00:14.90,0:00:15.15,Cap,,0,0,0,,{\pos(540,960)\blur0.5}It went
Dialogue: 0,0:00:15.15,0:00:16.04,Cap,,0,0,0,,{\pos(540,960)\blur0.5}to penalties again.
Dialogue: 0,0:00:16.04,0:00:16.59,Cap,,0,0,0,,{\pos(540,960)\blur0.5}But England's
Dialogue: 0,0:00:16.59,0:00:17.14,Cap,,0,0,0,,{\pos(540,960)\blur0.5}goalkeeper,
Dialogue: 0,0:00:17.14,0:00:17.96,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Jordan Pickford,
Dialogue: 0,0:00:17.96,0:00:18.76,Cap,,0,0,0,,{\pos(540,960)\blur0.5}had a secret.
Dialogue: 0,0:00:18.76,0:00:19.15,Cap,,0,0,0,,{\pos(540,960)\blur0.5}His water
Dialogue: 0,0:00:19.15,0:00:19.81,Cap,,0,0,0,,{\pos(540,960)\blur0.5}bottle had notes
Dialogue: 0,0:00:19.81,0:00:20.34,Cap,,0,0,0,,{\pos(540,960)\blur0.5}on it, showing
Dialogue: 0,0:00:20.34,0:00:21.13,Cap,,0,0,0,,{\pos(540,960)\blur0.5}where each Colombian
Dialogue: 0,0:00:21.13,0:00:21.62,Cap,,0,0,0,,{\pos(540,960)\blur0.5}player liked
Dialogue: 0,0:00:21.62,0:00:22.11,Cap,,0,0,0,,{\pos(540,960)\blur0.5}to shoot.
Dialogue: 0,0:00:22.11,0:00:22.46,Cap,,0,0,0,,{\pos(540,960)\blur0.5}And when he
Dialogue: 0,0:00:22.46,0:00:22.95,Cap,,0,0,0,,{\pos(540,960)\blur0.5}walked past
Dialogue: 0,0:00:22.95,0:00:23.76,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Colombia's keeper,
Dialogue: 0,0:00:23.76,0:00:24.21,Cap,,0,0,0,,{\pos(540,960)\blur0.5}he covered it
Dialogue: 0,0:00:24.21,0:00:24.81,Cap,,0,0,0,,{\pos(540,960)\blur0.5}with a towel.
Dialogue: 0,0:00:24.81,0:00:25.34,Cap,,0,0,0,,{\pos(540,960)\blur0.5}England missed
Dialogue: 0,0:00:25.34,0:00:26.09,Cap,,0,0,0,,{\pos(540,960)\blur0.5}their third kick.
Dialogue: 0,0:00:26.09,0:00:26.41,Cap,,0,0,0,,{\pos(540,960)\blur0.5}But then
Dialogue: 0,0:00:26.41,0:00:27.66,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Mateus Uribe smashed
Dialogue: 0,0:00:27.66,0:00:28.50,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Colombia's next one
Dialogue: 0,0:00:28.50,0:00:29.39,Cap,,0,0,0,,{\pos(540,960)\blur0.5}onto the crossbar.
Dialogue: 0,0:00:29.39,0:00:30.44,Cap,,0,0,0,,{\pos(540,960)\blur0.5}And when Carlos Bacca
Dialogue: 0,0:00:30.44,0:00:31.05,Cap,,0,0,0,,{\pos(540,960)\blur0.5}stepped up,
Dialogue: 0,0:00:31.05,0:00:31.75,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Pickford dived
Dialogue: 0,0:00:31.75,0:00:32.31,Cap,,0,0,0,,{\pos(540,960)\blur0.5}to his left,
Dialogue: 0,0:00:32.31,0:00:32.60,Cap,,0,0,0,,{\pos(540,960)\blur0.5}threw up
Dialogue: 0,0:00:32.60,0:00:33.01,Cap,,0,0,0,,{\pos(540,960)\blur0.5}his arm,
Dialogue: 0,0:00:33.01,0:00:33.62,Cap,,0,0,0,,{\pos(540,960)\blur0.5}and saved it.
Dialogue: 0,0:00:33.62,0:00:34.64,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Eric Dier scored,
Dialogue: 0,0:00:34.64,0:00:35.19,Cap,,0,0,0,,{\pos(540,960)\blur0.5}and England
Dialogue: 0,0:00:35.19,0:00:35.90,Cap,,0,0,0,,{\pos(540,960)\blur0.5}had finally won
Dialogue: 0,0:00:35.90,0:00:36.52,Cap,,0,0,0,,{\pos(540,960)\blur0.5}a World Cup
Dialogue: 0,0:00:36.52,0:00:37.00,Cap,,0,0,0,,{\pos(540,960)\blur0.5}shootout.
Dialogue: 0,0:00:37.00,0:00:37.58,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Afterwards,
Dialogue: 0,0:00:37.58,0:00:38.07,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Pickford said
Dialogue: 0,0:00:38.07,0:00:39.23,Cap,,0,0,0,,{\pos(540,960)\blur0.5}only one Colombian,
Dialogue: 0,0:00:39.23,0:00:40.05,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Radamel Falcao,
Dialogue: 0,0:00:40.05,0:00:40.98,Cap,,0,0,0,,{\pos(540,960)\blur0.5}had shot differently
Dialogue: 0,0:00:40.98,0:00:41.27,Cap,,0,0,0,,{\pos(540,960)\blur0.5}from what
Dialogue: 0,0:00:41.27,0:00:41.94,Cap,,0,0,0,,{\pos(540,960)\blur0.5}he expected.
Dialogue: 0,0:00:41.94,0:00:42.45,Cap,,0,0,0,,{\pos(540,960)\blur0.5}So Pickford
Dialogue: 0,0:00:42.45,0:00:43.15,Cap,,0,0,0,,{\pos(540,960)\blur0.5}kept the trick.
Dialogue: 0,0:00:43.15,0:00:43.60,Cap,,0,0,0,,{\pos(540,960)\blur0.5}In the Euro
Dialogue: 0,0:00:43.60,0:00:44.33,Cap,,0,0,0,,{\pos(540,960)\blur0.5}2020 final
Dialogue: 0,0:00:44.33,0:00:44.89,Cap,,0,0,0,,{\pos(540,960)\blur0.5}against Italy,
Dialogue: 0,0:00:44.89,0:00:45.16,Cap,,0,0,0,,{\pos(540,960)\blur0.5}he had
Dialogue: 0,0:00:45.16,0:00:45.94,Cap,,0,0,0,,{\pos(540,960)\blur0.5}his bottle again,
Dialogue: 0,0:00:45.94,0:00:46.56,Cap,,0,0,0,,{\pos(540,960)\blur0.5}and he saved
Dialogue: 0,0:00:46.56,0:00:47.36,Cap,,0,0,0,,{\pos(540,960)\blur0.5}two penalties,
Dialogue: 0,0:00:47.36,0:00:47.99,Cap,,0,0,0,,{\pos(540,960)\blur0.5}but England
Dialogue: 0,0:00:47.99,0:00:48.79,Cap,,0,0,0,,{\pos(540,960)\blur0.5}still lost.
Dialogue: 0,0:00:48.79,0:00:49.09,Cap,,0,0,0,,{\pos(540,960)\blur0.5}But here's
Dialogue: 0,0:00:49.09,0:00:49.78,Cap,,0,0,0,,{\pos(540,960)\blur0.5}the wild part.
Dialogue: 0,0:00:49.78,0:00:50.23,Cap,,0,0,0,,{\pos(540,960)\blur0.5}This summer,
Dialogue: 0,0:00:50.23,0:00:50.79,Cap,,0,0,0,,{\pos(540,960)\blur0.5}England played
Dialogue: 0,0:00:50.79,0:00:51.47,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Argentina in the
Dialogue: 0,0:00:51.47,0:00:52.51,Cap,,0,0,0,,{\pos(540,960)\blur0.5}World Cup semi-final,
Dialogue: 0,0:00:52.51,0:00:52.91,Cap,,0,0,0,,{\pos(540,960)\blur0.5}and Pickford
Dialogue: 0,0:00:52.91,0:00:53.38,Cap,,0,0,0,,{\pos(540,960)\blur0.5}had the bottle
Dialogue: 0,0:00:53.38,0:00:53.83,Cap,,0,0,0,,{\pos(540,960)\blur0.5}ready one
Dialogue: 0,0:00:53.83,0:00:54.42,Cap,,0,0,0,,{\pos(540,960)\blur0.5}more time.
Dialogue: 0,0:00:54.42,0:00:55.32,Cap,,0,0,0,,{\pos(540,960)\blur0.5}But Argentina scored
Dialogue: 0,0:00:55.32,0:00:56.16,Cap,,0,0,0,,{\pos(540,960)\blur0.5}in the 85th
Dialogue: 0,0:00:56.16,0:00:56.98,Cap,,0,0,0,,{\pos(540,960)\blur0.5}and the 92nd
Dialogue: 0,0:00:56.98,0:00:57.26,Cap,,0,0,0,,{\pos(540,960)\blur0.5}minute,
Dialogue: 0,0:00:57.26,0:00:57.56,Cap,,0,0,0,,{\pos(540,960)\blur0.5}so there
Dialogue: 0,0:00:57.56,0:00:58.36,Cap,,0,0,0,,{\pos(540,960)\blur0.5}was no shootout.
Dialogue: 0,0:00:58.36,0:00:59.14,Cap,,0,0,0,,{\pos(540,960)\blur0.5}And after the game,
Dialogue: 0,0:00:59.14,0:00:59.90,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Argentina found
Dialogue: 0,0:00:59.90,0:01:00.29,Cap,,0,0,0,,{\pos(540,960)\blur0.5}his bottle
Dialogue: 0,0:01:00.29,0:01:00.84,Cap,,0,0,0,,{\pos(540,960)\blur0.5}on the pitch,
Dialogue: 0,0:01:00.84,0:01:01.33,Cap,,0,0,0,,{\pos(540,960)\blur0.5}and passed
Dialogue: 0,0:01:01.33,0:01:01.93,Cap,,0,0,0,,{\pos(540,960)\blur0.5}it to Messi.
Dialogue: 0,0:01:01.93,0:01:02.38,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Next to one
Dialogue: 0,0:01:02.38,0:01:02.95,Cap,,0,0,0,,{\pos(540,960)\blur0.5}player's name,
Dialogue: 0,0:01:02.95,0:01:03.65,Cap,,0,0,0,,{\pos(540,960)\blur0.5}the note reportedly
Dialogue: 0,0:01:03.65,0:01:04.12,Cap,,0,0,0,,{\pos(540,960)\blur0.5}just said,
Dialogue: 0,0:01:04.12,0:01:04.94,Cap,,0,0,0,,{\pos(540,960)\blur0.5}feel on the day.
Dialogue: 0,0:01:04.94,0:01:05.41,Cap,,0,0,0,,{\pos(540,960)\blur0.5}And they couldn't
Dialogue: 0,0:01:05.41,0:01:06.40,Cap,,0,0,0,,{\pos(540,960)\blur0.5}stop laughing.
