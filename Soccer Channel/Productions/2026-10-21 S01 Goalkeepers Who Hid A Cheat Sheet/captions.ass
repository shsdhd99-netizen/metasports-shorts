Dialogue: 0,0:00:00.00,0:00:01.94,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Goalkeepers who hid a\NCHEAT SHEET in their sock
Dialogue: 0,0:00:01.94,0:00:03.04,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Back in 2006,
Dialogue: 0,0:00:03.04,0:00:03.67,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Germany hosted
Dialogue: 0,0:00:03.67,0:00:04.40,Cap,,0,0,0,,{\pos(540,960)\blur0.5}the World Cup,
Dialogue: 0,0:00:04.40,0:00:04.74,Cap,,0,0,0,,{\pos(540,960)\blur0.5}and in the
Dialogue: 0,0:00:04.74,0:00:05.42,Cap,,0,0,0,,{\pos(540,960)\blur0.5}quarterfinal they
Dialogue: 0,0:00:05.42,0:00:06.22,Cap,,0,0,0,,{\pos(540,960)\blur0.5}faced Argentina
Dialogue: 0,0:00:06.22,0:00:06.78,Cap,,0,0,0,,{\pos(540,960)\blur0.5}in Berlin.
Dialogue: 0,0:00:06.78,0:00:08.02,Cap,,0,0,0,,{\pos(540,960)\blur0.5}After 120 minutes
Dialogue: 0,0:00:08.02,0:00:08.58,Cap,,0,0,0,,{\pos(540,960)\blur0.5}it was still
Dialogue: 0,0:00:08.58,0:00:09.21,Cap,,0,0,0,,{\pos(540,960)\blur0.5}1-1,
Dialogue: 0,0:00:09.21,0:00:09.73,Cap,,0,0,0,,{\pos(540,960)\blur0.5}so the game
Dialogue: 0,0:00:09.73,0:00:10.46,Cap,,0,0,0,,{\pos(540,960)\blur0.5}went to penalties.
Dialogue: 0,0:00:10.46,0:00:11.44,Cap,,0,0,0,,{\pos(540,960)\blur0.5}But Germany's keeper,
Dialogue: 0,0:00:11.44,0:00:12.20,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Jens Lehmann,
Dialogue: 0,0:00:12.20,0:00:12.89,Cap,,0,0,0,,{\pos(540,960)\blur0.5}had a secret.
Dialogue: 0,0:00:12.89,0:00:13.74,Cap,,0,0,0,,{\pos(540,960)\blur0.5}His goalkeeping coach,
Dialogue: 0,0:00:13.74,0:00:14.57,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Andreas Köpke,
Dialogue: 0,0:00:14.57,0:00:15.16,Cap,,0,0,0,,{\pos(540,960)\blur0.5}had studied
Dialogue: 0,0:00:15.16,0:00:15.84,Cap,,0,0,0,,{\pos(540,960)\blur0.5}where Argentina's
Dialogue: 0,0:00:15.84,0:00:16.29,Cap,,0,0,0,,{\pos(540,960)\blur0.5}players liked
Dialogue: 0,0:00:16.29,0:00:16.73,Cap,,0,0,0,,{\pos(540,960)\blur0.5}to shoot,
Dialogue: 0,0:00:16.73,0:00:17.20,Cap,,0,0,0,,{\pos(540,960)\blur0.5}and the tips
Dialogue: 0,0:00:17.20,0:00:17.52,Cap,,0,0,0,,{\pos(540,960)\blur0.5}ended up
Dialogue: 0,0:00:17.52,0:00:17.99,Cap,,0,0,0,,{\pos(540,960)\blur0.5}on a tiny
Dialogue: 0,0:00:17.99,0:00:18.28,Cap,,0,0,0,,{\pos(540,960)\blur0.5}page
Dialogue: 0,0:00:18.28,0:00:18.73,Cap,,0,0,0,,{\pos(540,960)\blur0.5}from the team
Dialogue: 0,0:00:18.73,0:00:19.52,Cap,,0,0,0,,{\pos(540,960)\blur0.5}hotel's notepad.
Dialogue: 0,0:00:19.52,0:00:19.98,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Riquelme,
Dialogue: 0,0:00:19.98,0:00:20.57,Cap,,0,0,0,,{\pos(540,960)\blur0.5}left high.
Dialogue: 0,0:00:20.57,0:00:21.07,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Heinze,
Dialogue: 0,0:00:21.07,0:00:21.67,Cap,,0,0,0,,{\pos(540,960)\blur0.5}left low.
Dialogue: 0,0:00:21.67,0:00:22.28,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Even Messi
Dialogue: 0,0:00:22.28,0:00:22.66,Cap,,0,0,0,,{\pos(540,960)\blur0.5}was on it.
Dialogue: 0,0:00:22.66,0:00:23.19,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Lehmann tucked
Dialogue: 0,0:00:23.19,0:00:23.60,Cap,,0,0,0,,{\pos(540,960)\blur0.5}the paper
Dialogue: 0,0:00:23.60,0:00:24.23,Cap,,0,0,0,,{\pos(540,960)\blur0.5}into his sock.
Dialogue: 0,0:00:24.23,0:00:25.21,Cap,,0,0,0,,{\pos(540,960)\blur0.5}And before Argentina's
Dialogue: 0,0:00:25.21,0:00:25.56,Cap,,0,0,0,,{\pos(540,960)\blur0.5}kicks,
Dialogue: 0,0:00:25.56,0:00:25.84,Cap,,0,0,0,,{\pos(540,960)\blur0.5}he kept
Dialogue: 0,0:00:25.84,0:00:26.35,Cap,,0,0,0,,{\pos(540,960)\blur0.5}pulling it out
Dialogue: 0,0:00:26.35,0:00:26.93,Cap,,0,0,0,,{\pos(540,960)\blur0.5}to read it,
Dialogue: 0,0:00:26.93,0:00:27.32,Cap,,0,0,0,,{\pos(540,960)\blur0.5}right in front
Dialogue: 0,0:00:27.32,0:00:27.74,Cap,,0,0,0,,{\pos(540,960)\blur0.5}of the whole
Dialogue: 0,0:00:27.74,0:00:28.23,Cap,,0,0,0,,{\pos(540,960)\blur0.5}stadium.
Dialogue: 0,0:00:28.23,0:00:28.47,Cap,,0,0,0,,{\pos(540,960)\blur0.5}But there
Dialogue: 0,0:00:28.47,0:00:28.94,Cap,,0,0,0,,{\pos(540,960)\blur0.5}was one
Dialogue: 0,0:00:28.94,0:00:29.57,Cap,,0,0,0,,{\pos(540,960)\blur0.5}big problem.
Dialogue: 0,0:00:29.57,0:00:29.93,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Only two
Dialogue: 0,0:00:29.93,0:00:30.38,Cap,,0,0,0,,{\pos(540,960)\blur0.5}of the players
Dialogue: 0,0:00:30.38,0:00:30.78,Cap,,0,0,0,,{\pos(540,960)\blur0.5}on his list
Dialogue: 0,0:00:30.78,0:00:31.20,Cap,,0,0,0,,{\pos(540,960)\blur0.5}actually took
Dialogue: 0,0:00:31.20,0:00:31.71,Cap,,0,0,0,,{\pos(540,960)\blur0.5}a penalty.
Dialogue: 0,0:00:31.71,0:00:32.07,Cap,,0,0,0,,{\pos(540,960)\blur0.5}He saved
Dialogue: 0,0:00:32.07,0:00:32.98,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Roberto Ayala's,
Dialogue: 0,0:00:32.98,0:00:33.26,Cap,,0,0,0,,{\pos(540,960)\blur0.5}and he
Dialogue: 0,0:00:33.26,0:00:33.85,Cap,,0,0,0,,{\pos(540,960)\blur0.5}nearly saved
Dialogue: 0,0:00:33.85,0:00:34.89,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Maxi Rodríguez's.
Dialogue: 0,0:00:34.89,0:00:35.31,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Then came
Dialogue: 0,0:00:35.31,0:00:35.62,Cap,,0,0,0,,{\pos(540,960)\blur0.5}the kick
Dialogue: 0,0:00:35.62,0:00:36.19,Cap,,0,0,0,,{\pos(540,960)\blur0.5}that would decide
Dialogue: 0,0:00:36.19,0:00:36.70,Cap,,0,0,0,,{\pos(540,960)\blur0.5}everything.
Dialogue: 0,0:00:36.70,0:00:37.68,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Esteban Cambiasso
Dialogue: 0,0:00:37.68,0:00:38.18,Cap,,0,0,0,,{\pos(540,960)\blur0.5}walked up,
Dialogue: 0,0:00:38.18,0:00:38.64,Cap,,0,0,0,,{\pos(540,960)\blur0.5}and his name
Dialogue: 0,0:00:38.64,0:00:39.06,Cap,,0,0,0,,{\pos(540,960)\blur0.5}was nowhere
Dialogue: 0,0:00:39.06,0:00:39.66,Cap,,0,0,0,,{\pos(540,960)\blur0.5}on that paper.
Dialogue: 0,0:00:39.66,0:00:40.40,Cap,,0,0,0,,{\pos(540,960)\blur0.5}So Lehmann pulled
Dialogue: 0,0:00:40.40,0:00:41.15,Cap,,0,0,0,,{\pos(540,960)\blur0.5}it out anyway.
Dialogue: 0,0:00:41.15,0:00:41.64,Cap,,0,0,0,,{\pos(540,960)\blur0.5}He read it,
Dialogue: 0,0:00:41.64,0:00:41.99,Cap,,0,0,0,,{\pos(540,960)\blur0.5}nodded,
Dialogue: 0,0:00:41.99,0:00:42.28,Cap,,0,0,0,,{\pos(540,960)\blur0.5}and put it
Dialogue: 0,0:00:42.28,0:00:42.65,Cap,,0,0,0,,{\pos(540,960)\blur0.5}away,
Dialogue: 0,0:00:42.65,0:00:43.04,Cap,,0,0,0,,{\pos(540,960)\blur0.5}like he knew
Dialogue: 0,0:00:43.04,0:00:43.68,Cap,,0,0,0,,{\pos(540,960)\blur0.5}exactly what
Dialogue: 0,0:00:43.68,0:00:44.26,Cap,,0,0,0,,{\pos(540,960)\blur0.5}was coming.
Dialogue: 0,0:00:44.26,0:00:45.14,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Cambiasso shot,
Dialogue: 0,0:00:45.14,0:00:45.59,Cap,,0,0,0,,{\pos(540,960)\blur0.5}and Lehmann
Dialogue: 0,0:00:45.59,0:00:46.09,Cap,,0,0,0,,{\pos(540,960)\blur0.5}saved it.
Dialogue: 0,0:00:46.09,0:00:47.20,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Germany won 4-2.
Dialogue: 0,0:00:47.20,0:00:47.53,Cap,,0,0,0,,{\pos(540,960)\blur0.5}But here's
Dialogue: 0,0:00:47.53,0:00:48.23,Cap,,0,0,0,,{\pos(540,960)\blur0.5}the wild part.
Dialogue: 0,0:00:48.23,0:00:48.95,Cap,,0,0,0,,{\pos(540,960)\blur0.5}After the game,
Dialogue: 0,0:00:48.95,0:00:49.45,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Lehmann found
Dialogue: 0,0:00:49.45,0:00:50.16,Cap,,0,0,0,,{\pos(540,960)\blur0.5}the note lying
Dialogue: 0,0:00:50.16,0:00:50.55,Cap,,0,0,0,,{\pos(540,960)\blur0.5}on the dressing
Dialogue: 0,0:00:50.55,0:00:51.01,Cap,,0,0,0,,{\pos(540,960)\blur0.5}room floor,
Dialogue: 0,0:00:51.01,0:00:51.97,Cap,,0,0,0,,{\pos(540,960)\blur0.5}next to his socks.
Dialogue: 0,0:00:51.97,0:00:52.58,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Months later,
Dialogue: 0,0:00:52.58,0:00:52.91,Cap,,0,0,0,,{\pos(540,960)\blur0.5}the boss
Dialogue: 0,0:00:52.91,0:00:53.35,Cap,,0,0,0,,{\pos(540,960)\blur0.5}of a German
Dialogue: 0,0:00:53.35,0:00:53.94,Cap,,0,0,0,,{\pos(540,960)\blur0.5}energy company
Dialogue: 0,0:00:53.94,0:00:54.23,Cap,,0,0,0,,{\pos(540,960)\blur0.5}bought it
Dialogue: 0,0:00:54.23,0:00:54.64,Cap,,0,0,0,,{\pos(540,960)\blur0.5}for one
Dialogue: 0,0:00:54.64,0:00:55.42,Cap,,0,0,0,,{\pos(540,960)\blur0.5}million euros,
Dialogue: 0,0:00:55.42,0:00:55.89,Cap,,0,0,0,,{\pos(540,960)\blur0.5}at a charity
Dialogue: 0,0:00:55.89,0:00:56.71,Cap,,0,0,0,,{\pos(540,960)\blur0.5}auction for children.
Dialogue: 0,0:00:56.71,0:00:57.66,Cap,,0,0,0,,{\pos(540,960)\blur0.5}One million euros,
Dialogue: 0,0:00:57.66,0:00:58.19,Cap,,0,0,0,,{\pos(540,960)\blur0.5}for a page
Dialogue: 0,0:00:58.19,0:00:58.73,Cap,,0,0,0,,{\pos(540,960)\blur0.5}from a hotel
Dialogue: 0,0:00:58.73,0:00:59.48,Cap,,0,0,0,,{\pos(540,960)\blur0.5}notepad.
