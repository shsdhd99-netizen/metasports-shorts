Dialogue: 0,0:00:00.00,0:00:02.00,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Goalkeepers who hid a\NCHEAT SHEET in their sock
Dialogue: 0,0:00:02.00,0:00:03.10,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Back in 2006,
Dialogue: 0,0:00:03.10,0:00:03.73,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Germany hosted
Dialogue: 0,0:00:03.73,0:00:04.46,Cap,,0,0,0,,{\pos(540,960)\blur0.5}the World Cup,
Dialogue: 0,0:00:04.46,0:00:04.80,Cap,,0,0,0,,{\pos(540,960)\blur0.5}and in the
Dialogue: 0,0:00:04.80,0:00:05.48,Cap,,0,0,0,,{\pos(540,960)\blur0.5}quarterfinal they
Dialogue: 0,0:00:05.48,0:00:06.28,Cap,,0,0,0,,{\pos(540,960)\blur0.5}faced Argentina
Dialogue: 0,0:00:06.28,0:00:06.84,Cap,,0,0,0,,{\pos(540,960)\blur0.5}in Berlin.
Dialogue: 0,0:00:06.84,0:00:08.08,Cap,,0,0,0,,{\pos(540,960)\blur0.5}After 120 minutes
Dialogue: 0,0:00:08.08,0:00:08.64,Cap,,0,0,0,,{\pos(540,960)\blur0.5}it was still
Dialogue: 0,0:00:08.64,0:00:09.27,Cap,,0,0,0,,{\pos(540,960)\blur0.5}1-1,
Dialogue: 0,0:00:09.27,0:00:09.79,Cap,,0,0,0,,{\pos(540,960)\blur0.5}so the game
Dialogue: 0,0:00:09.79,0:00:10.59,Cap,,0,0,0,,{\pos(540,960)\blur0.5}went to penalties.
Dialogue: 0,0:00:10.59,0:00:11.56,Cap,,0,0,0,,{\pos(540,960)\blur0.5}But Germany's keeper,
Dialogue: 0,0:00:11.56,0:00:12.32,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Jens Lehmann,
Dialogue: 0,0:00:12.32,0:00:13.02,Cap,,0,0,0,,{\pos(540,960)\blur0.5}had a secret.
Dialogue: 0,0:00:13.02,0:00:13.86,Cap,,0,0,0,,{\pos(540,960)\blur0.5}His goalkeeping coach,
Dialogue: 0,0:00:13.86,0:00:14.70,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Andreas Köpke,
Dialogue: 0,0:00:14.70,0:00:15.28,Cap,,0,0,0,,{\pos(540,960)\blur0.5}had studied
Dialogue: 0,0:00:15.28,0:00:15.96,Cap,,0,0,0,,{\pos(540,960)\blur0.5}where Argentina's
Dialogue: 0,0:00:15.96,0:00:16.42,Cap,,0,0,0,,{\pos(540,960)\blur0.5}players liked
Dialogue: 0,0:00:16.42,0:00:16.86,Cap,,0,0,0,,{\pos(540,960)\blur0.5}to shoot,
Dialogue: 0,0:00:16.86,0:00:17.32,Cap,,0,0,0,,{\pos(540,960)\blur0.5}and the tips
Dialogue: 0,0:00:17.32,0:00:17.65,Cap,,0,0,0,,{\pos(540,960)\blur0.5}ended up
Dialogue: 0,0:00:17.65,0:00:18.11,Cap,,0,0,0,,{\pos(540,960)\blur0.5}on a tiny
Dialogue: 0,0:00:18.11,0:00:18.40,Cap,,0,0,0,,{\pos(540,960)\blur0.5}page
Dialogue: 0,0:00:18.40,0:00:18.85,Cap,,0,0,0,,{\pos(540,960)\blur0.5}from the team
Dialogue: 0,0:00:18.85,0:00:19.64,Cap,,0,0,0,,{\pos(540,960)\blur0.5}hotel's notepad.
Dialogue: 0,0:00:19.64,0:00:20.11,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Riquelme,
Dialogue: 0,0:00:20.11,0:00:20.69,Cap,,0,0,0,,{\pos(540,960)\blur0.5}left high.
Dialogue: 0,0:00:20.69,0:00:21.19,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Heinze,
Dialogue: 0,0:00:21.19,0:00:21.79,Cap,,0,0,0,,{\pos(540,960)\blur0.5}left low.
Dialogue: 0,0:00:21.79,0:00:22.41,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Even Messi
Dialogue: 0,0:00:22.41,0:00:23.11,Cap,,0,0,0,,{\pos(540,960)\blur0.5}was on it.
Dialogue: 0,0:00:23.11,0:00:23.64,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Lehmann tucked
Dialogue: 0,0:00:23.64,0:00:24.05,Cap,,0,0,0,,{\pos(540,960)\blur0.5}the paper
Dialogue: 0,0:00:24.05,0:00:24.72,Cap,,0,0,0,,{\pos(540,960)\blur0.5}into his sock.
Dialogue: 0,0:00:24.72,0:00:25.71,Cap,,0,0,0,,{\pos(540,960)\blur0.5}And before Argentina's
Dialogue: 0,0:00:25.71,0:00:26.05,Cap,,0,0,0,,{\pos(540,960)\blur0.5}kicks,
Dialogue: 0,0:00:26.05,0:00:26.33,Cap,,0,0,0,,{\pos(540,960)\blur0.5}he kept
Dialogue: 0,0:00:26.33,0:00:26.84,Cap,,0,0,0,,{\pos(540,960)\blur0.5}pulling it out
Dialogue: 0,0:00:26.84,0:00:27.43,Cap,,0,0,0,,{\pos(540,960)\blur0.5}to read it,
Dialogue: 0,0:00:27.43,0:00:27.82,Cap,,0,0,0,,{\pos(540,960)\blur0.5}right in front
Dialogue: 0,0:00:27.82,0:00:28.24,Cap,,0,0,0,,{\pos(540,960)\blur0.5}of the whole
Dialogue: 0,0:00:28.24,0:00:28.73,Cap,,0,0,0,,{\pos(540,960)\blur0.5}stadium.
Dialogue: 0,0:00:28.73,0:00:28.97,Cap,,0,0,0,,{\pos(540,960)\blur0.5}But there
Dialogue: 0,0:00:28.97,0:00:29.43,Cap,,0,0,0,,{\pos(540,960)\blur0.5}was one
Dialogue: 0,0:00:29.43,0:00:30.07,Cap,,0,0,0,,{\pos(540,960)\blur0.5}big problem.
Dialogue: 0,0:00:30.07,0:00:30.43,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Only two
Dialogue: 0,0:00:30.43,0:00:30.87,Cap,,0,0,0,,{\pos(540,960)\blur0.5}of the players
Dialogue: 0,0:00:30.87,0:00:31.28,Cap,,0,0,0,,{\pos(540,960)\blur0.5}on his list
Dialogue: 0,0:00:31.28,0:00:31.70,Cap,,0,0,0,,{\pos(540,960)\blur0.5}actually took
Dialogue: 0,0:00:31.70,0:00:32.21,Cap,,0,0,0,,{\pos(540,960)\blur0.5}a penalty.
Dialogue: 0,0:00:32.21,0:00:32.57,Cap,,0,0,0,,{\pos(540,960)\blur0.5}He saved
Dialogue: 0,0:00:32.57,0:00:33.47,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Roberto Ayala's,
Dialogue: 0,0:00:33.47,0:00:33.75,Cap,,0,0,0,,{\pos(540,960)\blur0.5}and he
Dialogue: 0,0:00:33.75,0:00:34.34,Cap,,0,0,0,,{\pos(540,960)\blur0.5}nearly saved
Dialogue: 0,0:00:34.34,0:00:35.39,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Maxi Rodríguez's.
Dialogue: 0,0:00:35.39,0:00:35.81,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Then came
Dialogue: 0,0:00:35.81,0:00:36.12,Cap,,0,0,0,,{\pos(540,960)\blur0.5}the kick
Dialogue: 0,0:00:36.12,0:00:36.69,Cap,,0,0,0,,{\pos(540,960)\blur0.5}that would decide
Dialogue: 0,0:00:36.69,0:00:37.20,Cap,,0,0,0,,{\pos(540,960)\blur0.5}everything.
Dialogue: 0,0:00:37.20,0:00:38.18,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Esteban Cambiasso
Dialogue: 0,0:00:38.18,0:00:38.67,Cap,,0,0,0,,{\pos(540,960)\blur0.5}walked up,
Dialogue: 0,0:00:38.67,0:00:39.14,Cap,,0,0,0,,{\pos(540,960)\blur0.5}and his name
Dialogue: 0,0:00:39.14,0:00:39.56,Cap,,0,0,0,,{\pos(540,960)\blur0.5}was nowhere
Dialogue: 0,0:00:39.56,0:00:40.16,Cap,,0,0,0,,{\pos(540,960)\blur0.5}on that paper.
Dialogue: 0,0:00:40.16,0:00:40.89,Cap,,0,0,0,,{\pos(540,960)\blur0.5}So Lehmann pulled
Dialogue: 0,0:00:40.89,0:00:41.65,Cap,,0,0,0,,{\pos(540,960)\blur0.5}it out anyway.
Dialogue: 0,0:00:41.65,0:00:42.14,Cap,,0,0,0,,{\pos(540,960)\blur0.5}He read it,
Dialogue: 0,0:00:42.14,0:00:42.48,Cap,,0,0,0,,{\pos(540,960)\blur0.5}nodded,
Dialogue: 0,0:00:42.48,0:00:42.77,Cap,,0,0,0,,{\pos(540,960)\blur0.5}and put it
Dialogue: 0,0:00:42.77,0:00:43.15,Cap,,0,0,0,,{\pos(540,960)\blur0.5}away,
Dialogue: 0,0:00:43.15,0:00:43.54,Cap,,0,0,0,,{\pos(540,960)\blur0.5}like he knew
Dialogue: 0,0:00:43.54,0:00:44.18,Cap,,0,0,0,,{\pos(540,960)\blur0.5}exactly what
Dialogue: 0,0:00:44.18,0:00:44.76,Cap,,0,0,0,,{\pos(540,960)\blur0.5}was coming.
Dialogue: 0,0:00:44.76,0:00:45.64,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Cambiasso shot,
Dialogue: 0,0:00:45.64,0:00:46.08,Cap,,0,0,0,,{\pos(540,960)\blur0.5}and Lehmann
Dialogue: 0,0:00:46.08,0:00:46.63,Cap,,0,0,0,,{\pos(540,960)\blur0.5}saved it.
Dialogue: 0,0:00:46.63,0:00:47.74,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Germany won 4-2.
Dialogue: 0,0:00:47.74,0:00:48.07,Cap,,0,0,0,,{\pos(540,960)\blur0.5}But here's
Dialogue: 0,0:00:48.07,0:00:48.78,Cap,,0,0,0,,{\pos(540,960)\blur0.5}the wild part.
Dialogue: 0,0:00:48.78,0:00:49.50,Cap,,0,0,0,,{\pos(540,960)\blur0.5}After the game,
Dialogue: 0,0:00:49.50,0:00:49.99,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Lehmann found
Dialogue: 0,0:00:49.99,0:00:50.70,Cap,,0,0,0,,{\pos(540,960)\blur0.5}the note lying
Dialogue: 0,0:00:50.70,0:00:51.09,Cap,,0,0,0,,{\pos(540,960)\blur0.5}on the dressing
Dialogue: 0,0:00:51.09,0:00:51.55,Cap,,0,0,0,,{\pos(540,960)\blur0.5}room floor,
Dialogue: 0,0:00:51.55,0:00:52.52,Cap,,0,0,0,,{\pos(540,960)\blur0.5}next to his socks.
Dialogue: 0,0:00:52.52,0:00:53.12,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Months later,
Dialogue: 0,0:00:53.12,0:00:53.45,Cap,,0,0,0,,{\pos(540,960)\blur0.5}the boss
Dialogue: 0,0:00:53.45,0:00:53.90,Cap,,0,0,0,,{\pos(540,960)\blur0.5}of a German
Dialogue: 0,0:00:53.90,0:00:54.48,Cap,,0,0,0,,{\pos(540,960)\blur0.5}energy company
Dialogue: 0,0:00:54.48,0:00:54.77,Cap,,0,0,0,,{\pos(540,960)\blur0.5}bought it
Dialogue: 0,0:00:54.77,0:00:55.19,Cap,,0,0,0,,{\pos(540,960)\blur0.5}for one
Dialogue: 0,0:00:55.19,0:00:55.96,Cap,,0,0,0,,{\pos(540,960)\blur0.5}million euros,
Dialogue: 0,0:00:55.96,0:00:56.43,Cap,,0,0,0,,{\pos(540,960)\blur0.5}at a charity
Dialogue: 0,0:00:56.43,0:00:57.25,Cap,,0,0,0,,{\pos(540,960)\blur0.5}auction for children.
Dialogue: 0,0:00:57.25,0:00:58.20,Cap,,0,0,0,,{\pos(540,960)\blur0.5}One million euros,
Dialogue: 0,0:00:58.20,0:00:58.73,Cap,,0,0,0,,{\pos(540,960)\blur0.5}for a page
Dialogue: 0,0:00:58.73,0:00:59.27,Cap,,0,0,0,,{\pos(540,960)\blur0.5}from a hotel
Dialogue: 0,0:00:59.27,0:00:59.75,Cap,,0,0,0,,{\pos(540,960)\blur0.5}notepad.
Dialogue: 0,0:00:59.75,0:01:00.15,Cap,,0,0,0,,{\pos(540,960)\blur0.5}And my next
Dialogue: 0,0:01:00.15,0:01:00.49,Cap,,0,0,0,,{\pos(540,960)\blur0.5}video is
Dialogue: 0,0:01:00.49,0:01:01.07,Cap,,0,0,0,,{\pos(540,960)\blur0.5}about the fire
Dialogue: 0,0:01:01.07,0:01:01.98,Cap,,0,0,0,,{\pos(540,960)\blur0.5}at Mario Balotelli's
Dialogue: 0,0:01:01.98,0:01:02.30,Cap,,0,0,0,,{\pos(540,960)\blur0.5}house,
Dialogue: 0,0:01:02.30,0:01:02.58,Cap,,0,0,0,,{\pos(540,960)\blur0.5}the day
Dialogue: 0,0:01:02.58,0:01:02.91,Cap,,0,0,0,,{\pos(540,960)\blur0.5}before the
Dialogue: 0,0:01:02.91,0:01:03.72,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Manchester derby.
Dialogue: 0,0:01:03.72,0:01:04.18,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Follow if you
Dialogue: 0,0:01:04.18,0:01:04.83,Cap,,0,0,0,,{\pos(540,960)\blur0.5}want the algorithm
Dialogue: 0,0:01:04.83,0:01:05.10,Cap,,0,0,0,,{\pos(540,960)\blur0.5}to show
Dialogue: 0,0:01:05.10,0:01:06.06,Cap,,0,0,0,,{\pos(540,960)\blur0.5}it to you.
