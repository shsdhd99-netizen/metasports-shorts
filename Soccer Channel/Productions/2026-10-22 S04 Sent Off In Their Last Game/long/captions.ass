Dialogue: 0,0:00:00.00,0:00:02.33,Cap,,0,0,0,,{\pos(540,960)\blur0.5\fscx92\fscy92}Players who got SENT OFF\Nin their very last game
Dialogue: 0,0:00:02.33,0:00:03.42,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Back in 2006,
Dialogue: 0,0:00:03.42,0:00:04.21,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Zinedine Zidane
Dialogue: 0,0:00:04.21,0:00:05.09,Cap,,0,0,0,,{\pos(540,960)\blur0.5}had already announced
Dialogue: 0,0:00:05.09,0:00:05.91,Cap,,0,0,0,,{\pos(540,960)\blur0.5}that the World Cup
Dialogue: 0,0:00:05.91,0:00:06.26,Cap,,0,0,0,,{\pos(540,960)\blur0.5}would be the
Dialogue: 0,0:00:06.26,0:00:06.90,Cap,,0,0,0,,{\pos(540,960)\blur0.5}last tournament
Dialogue: 0,0:00:06.90,0:00:07.57,Cap,,0,0,0,,{\pos(540,960)\blur0.5}of his career.
Dialogue: 0,0:00:07.57,0:00:07.95,Cap,,0,0,0,,{\pos(540,960)\blur0.5}And France
Dialogue: 0,0:00:07.95,0:00:08.17,Cap,,0,0,0,,{\pos(540,960)\blur0.5}made it
Dialogue: 0,0:00:08.17,0:00:08.53,Cap,,0,0,0,,{\pos(540,960)\blur0.5}all the way
Dialogue: 0,0:00:08.53,0:00:09.14,Cap,,0,0,0,,{\pos(540,960)\blur0.5}to the final
Dialogue: 0,0:00:09.14,0:00:09.80,Cap,,0,0,0,,{\pos(540,960)\blur0.5}against Italy,
Dialogue: 0,0:00:09.80,0:00:10.41,Cap,,0,0,0,,{\pos(540,960)\blur0.5}in Berlin.
Dialogue: 0,0:00:10.41,0:00:11.24,Cap,,0,0,0,,{\pos(540,960)\blur0.5}After seven minutes,
Dialogue: 0,0:00:11.24,0:00:11.96,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Zidane stepped
Dialogue: 0,0:00:11.96,0:00:12.32,Cap,,0,0,0,,{\pos(540,960)\blur0.5}up to take
Dialogue: 0,0:00:12.32,0:00:12.96,Cap,,0,0,0,,{\pos(540,960)\blur0.5}a penalty against
Dialogue: 0,0:00:12.96,0:00:13.96,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Gianluigi Buffon.
Dialogue: 0,0:00:13.96,0:00:14.36,Cap,,0,0,0,,{\pos(540,960)\blur0.5}But instead
Dialogue: 0,0:00:14.36,0:00:15.08,Cap,,0,0,0,,{\pos(540,960)\blur0.5}of smashing it,
Dialogue: 0,0:00:15.08,0:00:15.44,Cap,,0,0,0,,{\pos(540,960)\blur0.5}he chipped it
Dialogue: 0,0:00:15.44,0:00:15.97,Cap,,0,0,0,,{\pos(540,960)\blur0.5}down the middle.
Dialogue: 0,0:00:15.97,0:00:16.33,Cap,,0,0,0,,{\pos(540,960)\blur0.5}The ball
Dialogue: 0,0:00:16.33,0:00:16.87,Cap,,0,0,0,,{\pos(540,960)\blur0.5}hit the underside
Dialogue: 0,0:00:16.87,0:00:17.58,Cap,,0,0,0,,{\pos(540,960)\blur0.5}of the crossbar,
Dialogue: 0,0:00:17.58,0:00:17.91,Cap,,0,0,0,,{\pos(540,960)\blur0.5}bounced
Dialogue: 0,0:00:17.91,0:00:18.55,Cap,,0,0,0,,{\pos(540,960)\blur0.5}over the line,
Dialogue: 0,0:00:18.55,0:00:19.04,Cap,,0,0,0,,{\pos(540,960)\blur0.5}and France
Dialogue: 0,0:00:19.04,0:00:19.57,Cap,,0,0,0,,{\pos(540,960)\blur0.5}were winning.
Dialogue: 0,0:00:19.57,0:00:20.34,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Twelve minutes later,
Dialogue: 0,0:00:20.34,0:00:21.42,Cap,,0,0,0,,{\pos(540,960)\blur0.5\fscx99\fscy99}Marco Materazzi headed
Dialogue: 0,0:00:21.42,0:00:22.22,Cap,,0,0,0,,{\pos(540,960)\blur0.5}in the equalizer.
Dialogue: 0,0:00:22.22,0:00:22.65,Cap,,0,0,0,,{\pos(540,960)\blur0.5}The game went
Dialogue: 0,0:00:22.65,0:00:23.32,Cap,,0,0,0,,{\pos(540,960)\blur0.5}to extra time,
Dialogue: 0,0:00:23.32,0:00:23.81,Cap,,0,0,0,,{\pos(540,960)\blur0.5}and Zidane
Dialogue: 0,0:00:23.81,0:00:24.37,Cap,,0,0,0,,{\pos(540,960)\blur0.5}almost won it
Dialogue: 0,0:00:24.37,0:00:24.88,Cap,,0,0,0,,{\pos(540,960)\blur0.5}with a header,
Dialogue: 0,0:00:24.88,0:00:25.47,Cap,,0,0,0,,{\pos(540,960)\blur0.5}but Buffon
Dialogue: 0,0:00:25.47,0:00:25.76,Cap,,0,0,0,,{\pos(540,960)\blur0.5}tipped it
Dialogue: 0,0:00:25.76,0:00:26.43,Cap,,0,0,0,,{\pos(540,960)\blur0.5}over the bar.
Dialogue: 0,0:00:26.43,0:00:26.70,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Then,
Dialogue: 0,0:00:26.70,0:00:27.63,Cap,,0,0,0,,{\pos(540,960)\blur0.5}in the 110th
Dialogue: 0,0:00:27.63,0:00:27.92,Cap,,0,0,0,,{\pos(540,960)\blur0.5}minute,
Dialogue: 0,0:00:27.92,0:00:28.91,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Zidane and Materazzi
Dialogue: 0,0:00:28.91,0:00:29.30,Cap,,0,0,0,,{\pos(540,960)\blur0.5}exchanged
Dialogue: 0,0:00:29.30,0:00:30.08,Cap,,0,0,0,,{\pos(540,960)\blur0.5}a few words.
Dialogue: 0,0:00:30.08,0:00:31.09,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Zidane walked away.
Dialogue: 0,0:00:31.09,0:00:31.49,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Then he turned
Dialogue: 0,0:00:31.49,0:00:32.17,Cap,,0,0,0,,{\pos(540,960)\blur0.5}around and headbutted
Dialogue: 0,0:00:32.17,0:00:32.94,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Materazzi right
Dialogue: 0,0:00:32.94,0:00:33.61,Cap,,0,0,0,,{\pos(540,960)\blur0.5}in the chest.
Dialogue: 0,0:00:33.61,0:00:34.18,Cap,,0,0,0,,{\pos(540,960)\blur0.5}The referee hadn't
Dialogue: 0,0:00:34.18,0:00:34.70,Cap,,0,0,0,,{\pos(540,960)\blur0.5}even seen it.
Dialogue: 0,0:00:34.70,0:00:35.11,Cap,,0,0,0,,{\pos(540,960)\blur0.5}But the fourth
Dialogue: 0,0:00:35.11,0:00:35.70,Cap,,0,0,0,,{\pos(540,960)\blur0.5}official had.
Dialogue: 0,0:00:35.70,0:00:36.30,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Through the referee's
Dialogue: 0,0:00:36.30,0:00:36.65,Cap,,0,0,0,,{\pos(540,960)\blur0.5}headset,
Dialogue: 0,0:00:36.65,0:00:37.13,Cap,,0,0,0,,{\pos(540,960)\blur0.5}he said:
Dialogue: 0,0:00:37.13,0:00:37.73,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Horacio,
Dialogue: 0,0:00:37.73,0:00:38.38,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Horacio,
Dialogue: 0,0:00:38.38,0:00:38.97,Cap,,0,0,0,,{\pos(540,960)\blur0.5}I saw it.
Dialogue: 0,0:00:38.97,0:00:39.46,Cap,,0,0,0,,{\pos(540,960)\blur0.5}And Zidane
Dialogue: 0,0:00:39.46,0:00:39.85,Cap,,0,0,0,,{\pos(540,960)\blur0.5}was shown
Dialogue: 0,0:00:39.85,0:00:40.68,Cap,,0,0,0,,{\pos(540,960)\blur0.5}a red card.
Dialogue: 0,0:00:40.68,0:00:40.93,Cap,,0,0,0,,{\pos(540,960)\blur0.5}So one
Dialogue: 0,0:00:40.93,0:00:41.43,Cap,,0,0,0,,{\pos(540,960)\blur0.5}of the greatest
Dialogue: 0,0:00:41.43,0:00:42.05,Cap,,0,0,0,,{\pos(540,960)\blur0.5}players of all
Dialogue: 0,0:00:42.05,0:00:42.63,Cap,,0,0,0,,{\pos(540,960)\blur0.5}time walked
Dialogue: 0,0:00:42.63,0:00:43.16,Cap,,0,0,0,,{\pos(540,960)\blur0.5}off the pitch
Dialogue: 0,0:00:43.16,0:00:43.75,Cap,,0,0,0,,{\pos(540,960)\blur0.5}for the last
Dialogue: 0,0:00:43.75,0:00:44.14,Cap,,0,0,0,,{\pos(540,960)\blur0.5}time,
Dialogue: 0,0:00:44.14,0:00:44.54,Cap,,0,0,0,,{\pos(540,960)\blur0.5}right past
Dialogue: 0,0:00:44.54,0:00:44.94,Cap,,0,0,0,,{\pos(540,960)\blur0.5}the World Cup
Dialogue: 0,0:00:44.94,0:00:45.43,Cap,,0,0,0,,{\pos(540,960)\blur0.5}trophy.
Dialogue: 0,0:00:45.43,0:00:46.10,Cap,,0,0,0,,{\pos(540,960)\blur0.5}And without him,
Dialogue: 0,0:00:46.10,0:00:46.56,Cap,,0,0,0,,{\pos(540,960)\blur0.5}France lost
Dialogue: 0,0:00:46.56,0:00:47.63,Cap,,0,0,0,,{\pos(540,960)\blur0.5}the shootout 5-3.
Dialogue: 0,0:00:47.63,0:00:47.96,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Italy
Dialogue: 0,0:00:47.96,0:00:49.15,Cap,,0,0,0,,{\pos(540,960)\blur0.5}were world champions.
Dialogue: 0,0:00:49.15,0:00:49.55,Cap,,0,0,0,,{\pos(540,960)\blur0.5}But here's
Dialogue: 0,0:00:49.55,0:00:50.28,Cap,,0,0,0,,{\pos(540,960)\blur0.5}the wild part.
Dialogue: 0,0:00:50.28,0:00:50.84,Cap,,0,0,0,,{\pos(540,960)\blur0.5}The next morning,
Dialogue: 0,0:00:50.84,0:00:51.45,Cap,,0,0,0,,{\pos(540,960)\blur0.5}FIFA announced
Dialogue: 0,0:00:51.45,0:00:51.89,Cap,,0,0,0,,{\pos(540,960)\blur0.5}the best
Dialogue: 0,0:00:51.89,0:00:52.41,Cap,,0,0,0,,{\pos(540,960)\blur0.5}player of the
Dialogue: 0,0:00:52.41,0:00:53.09,Cap,,0,0,0,,{\pos(540,960)\blur0.5}whole tournament.
Dialogue: 0,0:00:53.09,0:00:53.47,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Most of the
Dialogue: 0,0:00:53.47,0:00:54.15,Cap,,0,0,0,,{\pos(540,960)\blur0.5}journalists had voted
Dialogue: 0,0:00:54.15,0:00:54.78,Cap,,0,0,0,,{\pos(540,960)\blur0.5}before the final
Dialogue: 0,0:00:54.78,0:00:55.27,Cap,,0,0,0,,{\pos(540,960)\blur0.5}was over,
Dialogue: 0,0:00:55.27,0:00:56.04,Cap,,0,0,0,,{\pos(540,960)\blur0.5}before the headbutt.
Dialogue: 0,0:00:56.04,0:00:56.62,Cap,,0,0,0,,{\pos(540,960)\blur0.5}And the winner
Dialogue: 0,0:00:56.62,0:00:57.79,Cap,,0,0,0,,{\pos(540,960)\blur0.5}was Zinedine Zidane,
Dialogue: 0,0:00:57.79,0:00:59.27,Cap,,0,0,0,,{\pos(540,960)\blur0.5}with 2,012 points.
Dialogue: 0,0:00:59.27,0:00:59.98,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Italy's captain,
Dialogue: 0,0:00:59.98,0:01:00.89,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Fabio Cannavaro,
Dialogue: 0,0:01:00.89,0:01:02.84,Cap,,0,0,0,,{\pos(540,960)\blur0.5}got 1,977.
Dialogue: 0,0:01:02.84,0:01:03.71,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Just 35 points
Dialogue: 0,0:01:03.71,0:01:04.22,Cap,,0,0,0,,{\pos(540,960)\blur0.5}between them.
Dialogue: 0,0:01:04.22,0:01:04.44,Cap,,0,0,0,,{\pos(540,960)\blur0.5}The man
Dialogue: 0,0:01:04.44,0:01:04.85,Cap,,0,0,0,,{\pos(540,960)\blur0.5}who got sent
Dialogue: 0,0:01:04.85,0:01:05.11,Cap,,0,0,0,,{\pos(540,960)\blur0.5}off in the
Dialogue: 0,0:01:05.11,0:01:05.46,Cap,,0,0,0,,{\pos(540,960)\blur0.5}World Cup
Dialogue: 0,0:01:05.46,0:01:06.07,Cap,,0,0,0,,{\pos(540,960)\blur0.5}final was named
Dialogue: 0,0:01:06.07,0:01:06.40,Cap,,0,0,0,,{\pos(540,960)\blur0.5}the best
Dialogue: 0,0:01:06.40,0:01:06.83,Cap,,0,0,0,,{\pos(540,960)\blur0.5}player of the
Dialogue: 0,0:01:06.83,0:01:07.68,Cap,,0,0,0,,{\pos(540,960)\blur0.5}World Cup.
