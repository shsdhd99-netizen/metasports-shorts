Dialogue: 0,0:00:00.00,0:00:03.22,Cap,,0,0,0,,{\pos(540,960)\blur0.5\fscx62\fscy62}The manager Barcelona soaked\Nwith SPRINKLERS just got his REVENGE
Dialogue: 0,0:00:03.22,0:00:04.13,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Back in 2010,
Dialogue: 0,0:00:04.13,0:00:05.16,Cap,,0,0,0,,{\pos(540,960)\blur0.5}José Mourinho's Inter
Dialogue: 0,0:00:05.16,0:00:05.92,Cap,,0,0,0,,{\pos(540,960)\blur0.5}knocked Barcelona
Dialogue: 0,0:00:05.92,0:00:06.29,Cap,,0,0,0,,{\pos(540,960)\blur0.5}out of the
Dialogue: 0,0:00:06.29,0:00:06.95,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Champions League,
Dialogue: 0,0:00:06.95,0:00:07.73,Cap,,0,0,0,,{\pos(540,960)\blur0.5}at Camp Nou.
Dialogue: 0,0:00:07.73,0:00:08.32,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Inter lost
Dialogue: 0,0:00:08.32,0:00:09.28,Cap,,0,0,0,,{\pos(540,960)\blur0.5}the game 1-0,
Dialogue: 0,0:00:09.28,0:00:09.85,Cap,,0,0,0,,{\pos(540,960)\blur0.5}but went through
Dialogue: 0,0:00:09.85,0:00:10.49,Cap,,0,0,0,,{\pos(540,960)\blur0.5}on aggregate.
Dialogue: 0,0:00:10.49,0:00:11.27,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Mourinho sprinted
Dialogue: 0,0:00:11.27,0:00:11.75,Cap,,0,0,0,,{\pos(540,960)\blur0.5}onto the pitch
Dialogue: 0,0:00:11.75,0:00:12.29,Cap,,0,0,0,,{\pos(540,960)\blur0.5}with his finger
Dialogue: 0,0:00:12.29,0:00:12.81,Cap,,0,0,0,,{\pos(540,960)\blur0.5}in the air.
Dialogue: 0,0:00:12.81,0:00:13.48,Cap,,0,0,0,,{\pos(540,960)\blur0.5}So Barcelona's
Dialogue: 0,0:00:13.48,0:00:14.20,Cap,,0,0,0,,{\pos(540,960)\blur0.5}ground staff turned
Dialogue: 0,0:00:14.20,0:00:15.11,Cap,,0,0,0,,{\pos(540,960)\blur0.5}the sprinklers on.
Dialogue: 0,0:00:15.11,0:00:15.80,Cap,,0,0,0,,{\pos(540,960)\blur0.5}He didn't care.
Dialogue: 0,0:00:15.80,0:00:16.53,Cap,,0,0,0,,{\pos(540,960)\blur0.5}He kept celebrating
Dialogue: 0,0:00:16.53,0:00:17.13,Cap,,0,0,0,,{\pos(540,960)\blur0.5}in the spray.
Dialogue: 0,0:00:17.13,0:00:17.65,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Weeks later,
Dialogue: 0,0:00:17.65,0:00:17.93,Cap,,0,0,0,,{\pos(540,960)\blur0.5}he won
Dialogue: 0,0:00:17.93,0:00:18.45,Cap,,0,0,0,,{\pos(540,960)\blur0.5}the final
Dialogue: 0,0:00:18.45,0:00:18.96,Cap,,0,0,0,,{\pos(540,960)\blur0.5}and became
Dialogue: 0,0:00:18.96,0:00:20.03,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Real Madrid's manager.
Dialogue: 0,0:00:20.03,0:00:20.36,Cap,,0,0,0,,{\pos(540,960)\blur0.5}He left
Dialogue: 0,0:00:20.36,0:00:21.17,Cap,,0,0,0,,{\pos(540,960)\blur0.5}in 2013.
Dialogue: 0,0:00:21.17,0:00:21.81,Cap,,0,0,0,,{\pos(540,960)\blur0.5}But this summer,
Dialogue: 0,0:00:21.81,0:00:22.54,Cap,,0,0,0,,{\pos(540,960)\blur0.5}he came back.
Dialogue: 0,0:00:22.54,0:00:23.08,Cap,,0,0,0,,{\pos(540,960)\blur0.5}In September,
Dialogue: 0,0:00:23.08,0:00:23.62,Cap,,0,0,0,,{\pos(540,960)\blur0.5}before his first
Dialogue: 0,0:00:23.62,0:00:24.18,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Champions League
Dialogue: 0,0:00:24.18,0:00:24.75,Cap,,0,0,0,,{\pos(540,960)\blur0.5}game back,
Dialogue: 0,0:00:24.75,0:00:25.21,Cap,,0,0,0,,{\pos(540,960)\blur0.5}an Italian
Dialogue: 0,0:00:25.21,0:00:25.73,Cap,,0,0,0,,{\pos(540,960)\blur0.5}journalist handed
Dialogue: 0,0:00:25.73,0:00:26.29,Cap,,0,0,0,,{\pos(540,960)\blur0.5}him a gift.
Dialogue: 0,0:00:26.29,0:00:27.05,Cap,,0,0,0,,{\pos(540,960)\blur0.5}A garden sprinkler,
Dialogue: 0,0:00:27.05,0:00:27.55,Cap,,0,0,0,,{\pos(540,960)\blur0.5}with a bow
Dialogue: 0,0:00:27.55,0:00:27.89,Cap,,0,0,0,,{\pos(540,960)\blur0.5}on it.
Dialogue: 0,0:00:27.89,0:00:28.80,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Then came Sunday.
Dialogue: 0,0:00:28.80,0:00:29.11,Cap,,0,0,0,,{\pos(540,960)\blur0.5}His first
Dialogue: 0,0:00:29.11,0:00:29.92,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Clásico back,
Dialogue: 0,0:00:29.92,0:00:30.54,Cap,,0,0,0,,{\pos(540,960)\blur0.5}at Camp Nou.
Dialogue: 0,0:00:30.54,0:00:31.28,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Barcelona had won
Dialogue: 0,0:00:31.28,0:00:31.83,Cap,,0,0,0,,{\pos(540,960)\blur0.5}all nine
Dialogue: 0,0:00:31.83,0:00:32.55,Cap,,0,0,0,,{\pos(540,960)\blur0.5}league games.
Dialogue: 0,0:00:32.55,0:00:33.06,Cap,,0,0,0,,{\pos(540,960)\blur0.5}One more win
Dialogue: 0,0:00:33.06,0:00:33.38,Cap,,0,0,0,,{\pos(540,960)\blur0.5}would break
Dialogue: 0,0:00:33.38,0:00:33.69,Cap,,0,0,0,,{\pos(540,960)\blur0.5}a record
Dialogue: 0,0:00:33.69,0:00:34.87,Cap,,0,0,0,,{\pos(540,960)\blur0.5}set in 1968,
Dialogue: 0,0:00:34.87,0:00:35.71,Cap,,0,0,0,,{\pos(540,960)\blur0.5}by Real Madrid.
Dialogue: 0,0:00:35.71,0:00:36.44,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Madrid's goalkeeper,
Dialogue: 0,0:00:36.44,0:00:37.35,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Thibaut Courtois,
Dialogue: 0,0:00:37.35,0:00:38.08,Cap,,0,0,0,,{\pos(540,960)\blur0.5}had the flu.
Dialogue: 0,0:00:38.08,0:00:38.47,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Vinícius
Dialogue: 0,0:00:38.47,0:00:39.19,Cap,,0,0,0,,{\pos(540,960)\blur0.5}was suspended.
Dialogue: 0,0:00:39.19,0:00:40.12,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Mbappé scored.
Dialogue: 0,0:00:40.12,0:00:41.24,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Raphinha equalised.
Dialogue: 0,0:00:41.24,0:00:41.52,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Then,
Dialogue: 0,0:00:41.52,0:00:41.92,Cap,,0,0,0,,{\pos(540,960)\blur0.5}with time
Dialogue: 0,0:00:41.92,0:00:42.42,Cap,,0,0,0,,{\pos(540,960)\blur0.5}running out,
Dialogue: 0,0:00:42.42,0:00:43.59,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Mbappé scored again.
Dialogue: 0,0:00:43.59,0:00:44.36,Cap,,0,0,0,,{\pos(540,960)\blur0.5}His hundredth goal
Dialogue: 0,0:00:44.36,0:00:45.17,Cap,,0,0,0,,{\pos(540,960)\blur0.5}for Real Madrid.
Dialogue: 0,0:00:45.17,0:00:45.95,Cap,,0,0,0,,{\pos(540,960)\blur0.5}And Mourinho dropped
Dialogue: 0,0:00:45.95,0:00:46.49,Cap,,0,0,0,,{\pos(540,960)\blur0.5}to his knees
Dialogue: 0,0:00:46.49,0:00:47.19,Cap,,0,0,0,,{\pos(540,960)\blur0.5}on the touchline,
Dialogue: 0,0:00:47.19,0:00:47.56,Cap,,0,0,0,,{\pos(540,960)\blur0.5}just like
Dialogue: 0,0:00:47.56,0:00:47.93,Cap,,0,0,0,,{\pos(540,960)\blur0.5}that night
Dialogue: 0,0:00:47.93,0:00:48.60,Cap,,0,0,0,,{\pos(540,960)\blur0.5}in 2010.
Dialogue: 0,0:00:48.60,0:00:49.01,Cap,,0,0,0,,{\pos(540,960)\blur0.5}But here's
Dialogue: 0,0:00:49.01,0:00:49.67,Cap,,0,0,0,,{\pos(540,960)\blur0.5}the wild part.
Dialogue: 0,0:00:49.67,0:00:50.44,Cap,,0,0,0,,{\pos(540,960)\blur0.5}The record Barcelona
Dialogue: 0,0:00:50.44,0:00:51.17,Cap,,0,0,0,,{\pos(540,960)\blur0.5}were chasing belonged
Dialogue: 0,0:00:51.17,0:00:51.94,Cap,,0,0,0,,{\pos(540,960)\blur0.5}to Real Madrid.
Dialogue: 0,0:00:51.94,0:00:52.34,Cap,,0,0,0,,{\pos(540,960)\blur0.5}And the team
Dialogue: 0,0:00:52.34,0:00:52.99,Cap,,0,0,0,,{\pos(540,960)\blur0.5}that stopped them
Dialogue: 0,0:00:52.99,0:00:54.33,Cap,,0,0,0,,{\pos(540,960)\blur0.5}was Real Madrid.
