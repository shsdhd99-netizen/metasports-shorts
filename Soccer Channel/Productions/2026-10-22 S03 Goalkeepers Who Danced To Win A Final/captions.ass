Dialogue: 0,0:00:00.00,0:00:02.18,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Goalkeepers who DANCED\Non the line to win a final
Dialogue: 0,0:00:02.18,0:00:03.30,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Back in 2005,
Dialogue: 0,0:00:03.30,0:00:03.91,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Liverpool played
Dialogue: 0,0:00:03.91,0:00:04.82,Cap,,0,0,0,,{\pos(540,960)\blur0.5}AC Milan in
Dialogue: 0,0:00:04.82,0:00:05.49,Cap,,0,0,0,,{\pos(540,960)\blur0.5}the Champions League
Dialogue: 0,0:00:05.49,0:00:06.64,Cap,,0,0,0,,{\pos(540,960)\blur0.5}final in Istanbul.
Dialogue: 0,0:00:06.64,0:00:07.81,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Milan had Maldini,
Dialogue: 0,0:00:07.81,0:00:08.41,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Pirlo,
Dialogue: 0,0:00:08.41,0:00:09.82,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Kaká and Shevchenko,
Dialogue: 0,0:00:09.82,0:00:10.81,Cap,,0,0,0,,{\pos(540,960)\blur0.5}and Paolo Maldini
Dialogue: 0,0:00:10.81,0:00:11.32,Cap,,0,0,0,,{\pos(540,960)\blur0.5}scored inside
Dialogue: 0,0:00:11.32,0:00:11.92,Cap,,0,0,0,,{\pos(540,960)\blur0.5}the first minute.
Dialogue: 0,0:00:11.92,0:00:12.55,Cap,,0,0,0,,{\pos(540,960)\blur0.5}By half-time,
Dialogue: 0,0:00:12.55,0:00:12.90,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Milan
Dialogue: 0,0:00:12.90,0:00:13.75,Cap,,0,0,0,,{\pos(540,960)\blur0.5}were winning 3-0.
Dialogue: 0,0:00:13.75,0:00:14.16,Cap,,0,0,0,,{\pos(540,960)\blur0.5}But then
Dialogue: 0,0:00:14.16,0:00:14.89,Cap,,0,0,0,,{\pos(540,960)\blur0.5}came six minutes
Dialogue: 0,0:00:14.89,0:00:15.88,Cap,,0,0,0,,{\pos(540,960)\blur0.5}nobody saw coming.
Dialogue: 0,0:00:15.88,0:00:16.84,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Steven Gerrard scored
Dialogue: 0,0:00:16.84,0:00:17.40,Cap,,0,0,0,,{\pos(540,960)\blur0.5}with a header.
Dialogue: 0,0:00:17.40,0:00:18.16,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Vladimír Šmicer
Dialogue: 0,0:00:18.16,0:00:19.16,Cap,,0,0,0,,{\pos(540,960)\blur0.5}scored from distance.
Dialogue: 0,0:00:19.16,0:00:20.05,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Then Xabi Alonso's
Dialogue: 0,0:00:20.05,0:00:20.82,Cap,,0,0,0,,{\pos(540,960)\blur0.5}penalty was saved,
Dialogue: 0,0:00:20.82,0:00:21.18,Cap,,0,0,0,,{\pos(540,960)\blur0.5}and he
Dialogue: 0,0:00:21.18,0:00:22.05,Cap,,0,0,0,,{\pos(540,960)\blur0.5}scored the rebound.
Dialogue: 0,0:00:22.05,0:00:22.62,Cap,,0,0,0,,{\pos(540,960)\blur0.5}3-3.
Dialogue: 0,0:00:22.62,0:00:23.23,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Then, three minutes
Dialogue: 0,0:00:23.23,0:00:23.59,Cap,,0,0,0,,{\pos(540,960)\blur0.5}from the end
Dialogue: 0,0:00:23.59,0:00:24.23,Cap,,0,0,0,,{\pos(540,960)\blur0.5}of extra time,
Dialogue: 0,0:00:24.23,0:00:25.10,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Shevchenko had two
Dialogue: 0,0:00:25.10,0:00:25.74,Cap,,0,0,0,,{\pos(540,960)\blur0.5}shots from right
Dialogue: 0,0:00:25.74,0:00:25.96,Cap,,0,0,0,,{\pos(540,960)\blur0.5}in front
Dialogue: 0,0:00:25.96,0:00:26.49,Cap,,0,0,0,,{\pos(540,960)\blur0.5}of goal.
Dialogue: 0,0:00:26.49,0:00:27.34,Cap,,0,0,0,,{\pos(540,960)\blur0.5}And Jerzy Dudek
Dialogue: 0,0:00:27.34,0:00:28.19,Cap,,0,0,0,,{\pos(540,960)\blur0.5}saved both.
Dialogue: 0,0:00:28.19,0:00:28.84,Cap,,0,0,0,,{\pos(540,960)\blur0.5}In 2011,
Dialogue: 0,0:00:28.84,0:00:29.28,Cap,,0,0,0,,{\pos(540,960)\blur0.5}a UEFA
Dialogue: 0,0:00:29.28,0:00:29.94,Cap,,0,0,0,,{\pos(540,960)\blur0.5}poll voted it
Dialogue: 0,0:00:29.94,0:00:30.65,Cap,,0,0,0,,{\pos(540,960)\blur0.5}the greatest moment
Dialogue: 0,0:00:30.65,0:00:31.29,Cap,,0,0,0,,{\pos(540,960)\blur0.5}in Champions League
Dialogue: 0,0:00:31.29,0:00:31.74,Cap,,0,0,0,,{\pos(540,960)\blur0.5}history.
Dialogue: 0,0:00:31.74,0:00:32.06,Cap,,0,0,0,,{\pos(540,960)\blur0.5}So it went
Dialogue: 0,0:00:32.06,0:00:32.71,Cap,,0,0,0,,{\pos(540,960)\blur0.5}to penalties.
Dialogue: 0,0:00:32.71,0:00:33.33,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Dudek had studied
Dialogue: 0,0:00:33.33,0:00:33.84,Cap,,0,0,0,,{\pos(540,960)\blur0.5}about a hundred
Dialogue: 0,0:00:33.84,0:00:34.77,Cap,,0,0,0,,{\pos(540,960)\blur0.5}of Milan's penalties,
Dialogue: 0,0:00:34.77,0:00:35.45,Cap,,0,0,0,,{\pos(540,960)\blur0.5}and his goalkeeping
Dialogue: 0,0:00:35.45,0:00:35.99,Cap,,0,0,0,,{\pos(540,960)\blur0.5}coach was ready
Dialogue: 0,0:00:35.99,0:00:36.46,Cap,,0,0,0,,{\pos(540,960)\blur0.5}to signal
Dialogue: 0,0:00:36.46,0:00:37.42,Cap,,0,0,0,,{\pos(540,960)\blur0.5}left or right.
Dialogue: 0,0:00:37.42,0:00:37.77,Cap,,0,0,0,,{\pos(540,960)\blur0.5}But then
Dialogue: 0,0:00:37.77,0:00:38.67,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Jamie Carragher jumped
Dialogue: 0,0:00:38.67,0:00:39.17,Cap,,0,0,0,,{\pos(540,960)\blur0.5}on his back
Dialogue: 0,0:00:39.17,0:00:39.61,Cap,,0,0,0,,{\pos(540,960)\blur0.5}with a different
Dialogue: 0,0:00:39.61,0:00:40.11,Cap,,0,0,0,,{\pos(540,960)\blur0.5}idea.
Dialogue: 0,0:00:40.11,0:00:40.44,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Do what
Dialogue: 0,0:00:40.44,0:00:41.54,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Bruce Grobbelaar did.
Dialogue: 0,0:00:41.54,0:00:41.79,Cap,,0,0,0,,{\pos(540,960)\blur0.5}You see,
Dialogue: 0,0:00:41.79,0:00:42.62,Cap,,0,0,0,,{\pos(540,960)\blur0.5}in 1984,
Dialogue: 0,0:00:42.62,0:00:43.12,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Liverpool won
Dialogue: 0,0:00:43.12,0:00:43.50,Cap,,0,0,0,,{\pos(540,960)\blur0.5}the same
Dialogue: 0,0:00:43.50,0:00:44.53,Cap,,0,0,0,,{\pos(540,960)\blur0.5}trophy on penalties,
Dialogue: 0,0:00:44.53,0:00:45.35,Cap,,0,0,0,,{\pos(540,960)\blur0.5}against Roma,
Dialogue: 0,0:00:45.35,0:00:45.92,Cap,,0,0,0,,{\pos(540,960)\blur0.5}in Rome,
Dialogue: 0,0:00:45.92,0:00:46.52,Cap,,0,0,0,,{\pos(540,960)\blur0.5}and Grobbelaar
Dialogue: 0,0:00:46.52,0:00:47.39,Cap,,0,0,0,,{\pos(540,960)\blur0.5}wobbled his legs
Dialogue: 0,0:00:47.39,0:00:48.00,Cap,,0,0,0,,{\pos(540,960)\blur0.5}on the line.
Dialogue: 0,0:00:48.00,0:00:48.63,Cap,,0,0,0,,{\pos(540,960)\blur0.5}He said later,
Dialogue: 0,0:00:48.63,0:00:49.31,Cap,,0,0,0,,{\pos(540,960)\blur0.5}I'm in Rome,
Dialogue: 0,0:00:49.31,0:00:49.73,Cap,,0,0,0,,{\pos(540,960)\blur0.5}the national
Dialogue: 0,0:00:49.73,0:00:50.41,Cap,,0,0,0,,{\pos(540,960)\blur0.5}dish is spaghetti,
Dialogue: 0,0:00:50.41,0:00:50.71,Cap,,0,0,0,,{\pos(540,960)\blur0.5}so I'll
Dialogue: 0,0:00:50.71,0:00:51.69,Cap,,0,0,0,,{\pos(540,960)\blur0.5}do spaghetti legs.
Dialogue: 0,0:00:51.69,0:00:52.26,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Two Roma
Dialogue: 0,0:00:52.26,0:00:52.83,Cap,,0,0,0,,{\pos(540,960)\blur0.5}players missed.
Dialogue: 0,0:00:52.83,0:00:53.24,Cap,,0,0,0,,{\pos(540,960)\blur0.5}So Dudek
Dialogue: 0,0:00:53.24,0:00:53.87,Cap,,0,0,0,,{\pos(540,960)\blur0.5}started dancing
Dialogue: 0,0:00:53.87,0:00:54.47,Cap,,0,0,0,,{\pos(540,960)\blur0.5}on his line.
Dialogue: 0,0:00:54.47,0:00:55.39,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Serginho blasted
Dialogue: 0,0:00:55.39,0:00:56.31,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Milan's first penalty
Dialogue: 0,0:00:56.31,0:00:56.92,Cap,,0,0,0,,{\pos(540,960)\blur0.5}over the bar.
Dialogue: 0,0:00:56.92,0:00:57.56,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Dudek saved
Dialogue: 0,0:00:57.56,0:00:58.42,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Andrea Pirlo's.
Dialogue: 0,0:00:58.42,0:00:59.13,Cap,,0,0,0,,{\pos(540,960)\blur0.5}And when Shevchenko
Dialogue: 0,0:00:59.13,0:00:59.62,Cap,,0,0,0,,{\pos(540,960)\blur0.5}had to score
Dialogue: 0,0:00:59.62,0:00:59.86,Cap,,0,0,0,,{\pos(540,960)\blur0.5}to keep
Dialogue: 0,0:00:59.86,0:01:00.63,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Milan alive,
Dialogue: 0,0:01:00.63,0:01:01.35,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Dudek saved
Dialogue: 0,0:01:01.35,0:01:02.09,Cap,,0,0,0,,{\pos(540,960)\blur0.5}that one too.
Dialogue: 0,0:01:02.09,0:01:02.52,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Liverpool
Dialogue: 0,0:01:02.52,0:01:03.05,Cap,,0,0,0,,{\pos(540,960)\blur0.5}were champions
Dialogue: 0,0:01:03.05,0:01:03.46,Cap,,0,0,0,,{\pos(540,960)\blur0.5}of Europe.
Dialogue: 0,0:01:03.46,0:01:03.88,Cap,,0,0,0,,{\pos(540,960)\blur0.5}But here's
Dialogue: 0,0:01:03.88,0:01:04.50,Cap,,0,0,0,,{\pos(540,960)\blur0.5}the wild part.
Dialogue: 0,0:01:04.50,0:01:04.94,Cap,,0,0,0,,{\pos(540,960)\blur0.5}That summer,
Dialogue: 0,0:01:04.94,0:01:05.49,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Liverpool signed
Dialogue: 0,0:01:05.49,0:01:06.28,Cap,,0,0,0,,{\pos(540,960)\blur0.5}a new goalkeeper,
Dialogue: 0,0:01:06.28,0:01:07.05,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Pepe Reina.
Dialogue: 0,0:01:07.05,0:01:07.59,Cap,,0,0,0,,{\pos(540,960)\blur0.5}And in the two
Dialogue: 0,0:01:07.59,0:01:08.35,Cap,,0,0,0,,{\pos(540,960)\blur0.5}years that followed,
Dialogue: 0,0:01:08.35,0:01:08.76,Cap,,0,0,0,,{\pos(540,960)\blur0.5}the hero
Dialogue: 0,0:01:08.76,0:01:09.53,Cap,,0,0,0,,{\pos(540,960)\blur0.5}of Istanbul played
Dialogue: 0,0:01:09.53,0:01:10.74,Cap,,0,0,0,,{\pos(540,960)\blur0.5}just twelve games.
