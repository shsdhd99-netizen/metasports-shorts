Dialogue: 0,0:00:00.00,0:00:02.75,Cap,,0,0,0,,{\pos(540,960)\blur0.5\fscx66\fscy66}The goalkeeper who says Spain were\NSCARED of a shootout
Dialogue: 0,0:00:02.75,0:00:04.02,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Back in 2022,
Dialogue: 0,0:00:04.02,0:00:05.10,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Emiliano Martinez
Dialogue: 0,0:00:05.10,0:00:06.22,Cap,,0,0,0,,{\pos(540,960)\blur0.5}helped Argentina win
Dialogue: 0,0:00:06.22,0:00:06.73,Cap,,0,0,0,,{\pos(540,960)\blur0.5}the World Cup
Dialogue: 0,0:00:06.73,0:00:07.87,Cap,,0,0,0,,{\pos(540,960)\blur0.5}final on penalties.
Dialogue: 0,0:00:07.87,0:00:08.32,Cap,,0,0,0,,{\pos(540,960)\blur0.5}He saved
Dialogue: 0,0:00:08.32,0:00:09.46,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Kingsley Coman's kick.
Dialogue: 0,0:00:09.46,0:00:09.81,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Then,
Dialogue: 0,0:00:09.81,0:00:11.02,Cap,,0,0,0,,{\pos(540,960)\blur0.5}before Tchouameni
Dialogue: 0,0:00:11.02,0:00:11.51,Cap,,0,0,0,,{\pos(540,960)\blur0.5}stepped up,
Dialogue: 0,0:00:11.51,0:00:12.26,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Martinez threw
Dialogue: 0,0:00:12.26,0:00:12.99,Cap,,0,0,0,,{\pos(540,960)\blur0.5}the ball away,
Dialogue: 0,0:00:12.99,0:00:13.27,Cap,,0,0,0,,{\pos(540,960)\blur0.5}so he
Dialogue: 0,0:00:13.27,0:00:13.82,Cap,,0,0,0,,{\pos(540,960)\blur0.5}had to walk
Dialogue: 0,0:00:13.82,0:00:14.92,Cap,,0,0,0,,{\pos(540,960)\blur0.5}over and fetch it.
Dialogue: 0,0:00:14.92,0:00:16.77,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Tchouameni fired wide.
Dialogue: 0,0:00:16.77,0:00:18.37,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Argentina won 4-2.
Dialogue: 0,0:00:18.37,0:00:18.85,Cap,,0,0,0,,{\pos(540,960)\blur0.5}This summer,
Dialogue: 0,0:00:18.85,0:00:19.64,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Argentina were back
Dialogue: 0,0:00:19.64,0:00:20.28,Cap,,0,0,0,,{\pos(540,960)\blur0.5}in the final,
Dialogue: 0,0:00:20.28,0:00:21.32,Cap,,0,0,0,,{\pos(540,960)\blur0.5}against Spain.
Dialogue: 0,0:00:21.32,0:00:22.01,Cap,,0,0,0,,{\pos(540,960)\blur0.5}Martinez says
Dialogue: 0,0:00:22.01,0:00:22.38,Cap,,0,0,0,,{\pos(540,960)\blur0.5}he played
Dialogue: 0,0:00:22.38,0:00:23.11,Cap,,0,0,0,,{\pos(540,960)\blur0.5}the whole tournament
Dialogue: 0,0:00:23.11,0:00:23.70,Cap,,0,0,0,,{\pos(540,960)\blur0.5}with a broken
Dialogue: 0,0:00:23.70,0:00:24.14,Cap,,0,0,0,,{\pos(540,960)\blur0.5}finger.
Dialogue: 0,0:00:24.14,0:00:24.68,Cap,,0,0,0,,{\pos(540,960)\blur0.5}And he says
