# assemble.py scratch while rendering
**/_shots_tmp/

# Library: scratch from the music tests and the footage sheets stay local
Library/Music/tests/work/
Productions/**/_audit/clips/
Productions/**/src/

# YouTube Analytics API (Tools/yt_analytics.py): OAuth client file and tokens never go in git
Tools/client_secret*.json
**/yt_token*.json

# Oct 19 2026: audition analysis WAVs are rebuilt from the MP3 takes by the scripts; keep them out of git
Research Notes/Voice Audition*/takes/*.wav

# A/B voice renders link the parent clips/src (symlinks, not committed)
Productions/**/_designed/clips
Productions/**/_designed/src
Productions/**/_alex/clips
Productions/**/_alex/src

# Oct 21 2026: the soccer channel's own space (Soccer Channel/START HERE.md). Its drafts and card assets are kept; raw sources and clips stay local.
!/Soccer Channel/
!Soccer Channel/**/DRAFT - awaiting approval*.mp4
!Soccer Channel/**/assets/*.png
!Soccer Channel/**/assets/*.jpg
Soccer Channel/**/src/
Soccer Channel/**/clips/
Soccer Channel/**/_check/
Soccer Channel/**/take*_*/
Soccer Channel/**/_voice_*/
